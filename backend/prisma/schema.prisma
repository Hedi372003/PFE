generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Robot {
  id        String   @id @default(cuid())
  name      String
  latitude  Float
  longitude Float
  status    String   @default("offline")
  createdAt DateTime @default(now())
  robotId   String   @unique
  updatedAt DateTime @default(now()) @updatedAt

  @@map("robots")
}

model User {
  id                       String                    @id @default(uuid())
  firstName                String                    @map("first_name")
  lastName                 String                    @map("last_name")
  email                    String                    @unique
  phone                    String
  password                 String
  role                     String                    @default("user")
  robotId                  String?                   @map("robot_id")
  isActive                 Boolean                   @default(true) @map("is_active")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at")
  notificationReadReceipts NotificationReadReceipt[]

  @@map("users")
}

model Request {
  id        String   @id @default(cuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String
  phone     String
  robotId   String?  @map("robot_id")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  password  String?
  message   String?

  @@map("requests")
}

model CompanyProfile {
  id                String   @id @default("default")
  name              String
  supportEmail      String   @map("support_email")
  supportPhone      String   @map("support_phone")
  hours             String
  products          String[] @default([])
  welcomeMessage    String   @map("welcome_message")
  lobbyInstructions String   @map("lobby_instructions")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("company_profiles")
}

model Notification {
  id           String                    @id @default(cuid())
  title        String
  body         String
  kind         String                    @default("system")
  priority     String                    @default("info")
  targetRole   String?                   @map("target_role")
  targetUserId String?                   @map("target_user_id")
  metadata     Json?
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @default(now()) @updatedAt @map("updated_at")
  readReceipts NotificationReadReceipt[]

  @@index([createdAt])
  @@index([targetRole])
  @@index([targetUserId])
  @@map("notifications")
}

model NotificationReadReceipt {
  id             String       @id @default(cuid())
  notificationId String       @map("notification_id")
  userId         String       @map("user_id")
  readAt         DateTime     @default(now()) @map("read_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("notification_read_receipts")
}

model CallSession {
  id            String        @id @default(cuid())
  roomId        String        @unique @map("room_id")
  title         String?
  mode          String        @default("video")
  status        String        @default("scheduled")
  requestId     String?       @map("request_id")
  robotId       String?       @map("robot_id")
  operatorId    String?       @map("operator_id")
  visitorUserId String?       @map("visitor_user_id")
  visitorEmail  String?       @map("visitor_email")
  createdById   String?       @map("created_by_id")
  startedAt     DateTime?     @map("started_at")
  endedAt       DateTime?     @map("ended_at")
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")
  messages      CallMessage[]

  @@index([status])
  @@index([requestId])
  @@index([robotId])
  @@map("call_sessions")
}

model CallMessage {
  id         String      @id @default(cuid())
  sessionId  String      @map("session_id")
  senderId   String?     @map("sender_id")
  senderRole String      @map("sender_role")
  message    String
  createdAt  DateTime    @default(now()) @map("created_at")
  session    CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("call_messages")
}
